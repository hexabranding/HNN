# HEXA NEWS Backend Environment Template
# -------------------------------------------------------------
NODE_ENV=development
PORT=4000

# MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.n6wnc3y.mongodb.net/hexanews?appName=Cluster0

# Authentication Secret (JWT)
JWT_SECRET=change_to_a_secure_random_secret_in_production

# CORS Allowed Origins
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000

# Initial Admin Password (used if database has no admin user)
ADMIN_INITIAL_PASSWORD=Hexa@Admin123
